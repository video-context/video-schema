{
  "name": "@video-context/schema",
  "version": "0.1.0",
  "description": "An open JSON schema for video data: shots, scenes, transcripts, on-screen text, labels, objects, and logos. With converters from Google Video Intelligence, Amazon Rekognition, and Amazon Transcribe.",
  "license": "MIT",
  "author": "Video Context (https://videocontextapi.com)",
  "homepage": "https://github.com/video-context/video-schema#readme",
  "repository": { "type": "git", "url": "git+https://github.com/video-context/video-schema.git" },
  "bugs": "https://github.com/video-context/video-schema/issues",
  "keywords": ["video", "video-understanding", "json-schema", "video-intelligence", "rekognition", "transcribe", "shot-detection", "transcript", "ocr", "video-metadata", "ai-agents"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema.json": "./schema/video-context.schema.json"
  },
  "bin": { "video-schema": "./dist/cli.js" },
  "files": ["dist", "schema"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "tsc && node --test test/*.test.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
